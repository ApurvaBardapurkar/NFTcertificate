VITE_CHAIN_ID=91562037
VITE_CHAIN_NAME=MST Testnet
# Required for mint: the Node server calls this RPC for simulate + gas (same chain MetaMask must use).
VITE_RPC_URL=https://testnetrpc.mstblockchain.com
VITE_BLOCK_EXPLORER=https://testnet.mstscan.com/
VITE_NATIVE_NAME=MST
VITE_NATIVE_SYMBOL=MST
# Base fallback contract (optional if you set per-college contracts below)
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# One contract per college (recommended). Deploy the same contract 5 times and paste each address:
VITE_CONTRACT_ADDRESS_MIT=0x1a8c4321dBA279eac954695f305340b111e79d78
VITE_CONTRACT_ADDRESS_VIDYASHILP=0xf5b7D7f1bE480CF63031F833455DBA846fE07E69
VITE_CONTRACT_ADDRESS_REVA=0x287e568D08dC95cC7108268EE43e38b05fBbCE40
VITE_CONTRACT_ADDRESS_JAIN=0xd0604c4115777bD94AAdF1A38149f32A556FC115
VITE_CONTRACT_ADDRESS_BMS=0x57dc8B4356fd151eE41664b893B5253a9c7646A3

# Frontend → backend (optional in dev: leave unset to use Vite proxy /api → Express on PORT)
# VITE_IPFS_BACKEND=http://localhost:5190
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Mint tx: explicit gas avoids broken eth_estimateGas on some MST RPCs (MetaMask -32603).
# VITE_MINT_GAS_LIMIT=550000

# Backend (Pinata / IPFS)
# Put the JWT in a local `.env` file (NOT committed).
# PINATA_JWT=eyJhbGciOi...
# PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
# API server port (must match Vite proxy in vite.config.js — default 5190, not 5173+)
# PORT=5190
